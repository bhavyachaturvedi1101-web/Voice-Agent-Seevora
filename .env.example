# ============================================================
#  SEEVORA — Environment Variables Template
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to git!
# ============================================================

# JWT secret for signing auth tokens (use a long random string)
JWT_SECRET=your_jwt_secret_here

# Salt used for hashing passwords
PASSWORD_SALT=your_password_salt_here

# Your ngrok server base URL (no trailing slash)
# Used by the backend server
NGROK_BASE_URL=https://your-ngrok-url.ngrok-free.dev

# Same URL prefixed with VITE_ so the browser frontend can access it
VITE_NGROK_BASE_URL=https://your-ngrok-url.ngrok-free.dev

# Port for the local Express server
PORT=3000
